# Placeholder only — never commit real secrets.
# Copy to .env for local development. Production values come from the host's secret store.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/dsa_tracker
SESSION_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0
JSON_LIMIT=256kb
# Admin credentials are created with: npm run admin:create

# GitHub OAuth App (https://github.com/settings/developers > New OAuth App).
# Authorization callback URL in the app settings must equal GITHUB_CALLBACK_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback
GITHUB_SCOPE=read:user
# Optional fine-grained token with Contents: Read-only for the central repo.
# Recommended for private repositories or higher webhook volume.
GITHUB_REPO_TOKEN=

# Exactly two GitHub NUMERIC user IDs (profile id, not login — logins can change).
ADMIN_GITHUB_IDS=10000001,10000002

# Central repository + webhook intake (see docs/ADR-0005-evidence-worker.md).
# Expected central student repository: Satyamdiwaker000001/DSA_Batch_2027
# (branch main, student root students/). Values below stay empty on purpose:
# intake fails closed (503) until the operator configures them per environment.
CENTRAL_REPO_FULL_NAME=
CENTRAL_REPO_BRANCH=main
CENTRAL_REPO_FOLDER_ROOT=students/
GITHUB_WEBHOOK_SECRET=

# Rate limits (count per window-ms). Defaults are operational placeholders
# pending load/hosting data — see docs/ADR-0003-rate-limiting.md.
RL_GENERAL_WINDOW_MS=60000
RL_GENERAL_MAX=300
RL_AUTH_WINDOW_MS=900000
RL_AUTH_MAX=10
RL_ACCESS_WINDOW_MS=3600000
RL_ACCESS_MAX=5
RL_ADMIN_WINDOW_MS=60000
RL_ADMIN_MAX=60
RL_WEBHOOK_WINDOW_MS=60000
RL_WEBHOOK_MAX=120
CONC_WEBHOOK_MAX=5
CONC_WEBHOOK_SLOT_TTL_MS=60000

# Leaderboard formula (pending professor sign-off, FR-LB-04).
LB_VERIFIED_WEIGHT=10
LB_ACTIVE_DAY_WEIGHT=2
LB_WINDOW_DAYS=7
REPORT_TIMEZONE=UTC
