# Backend base URL (no trailing slash).
# - Set (e.g. http://localhost:5000) → live mode: real OAuth sessions,
#   approvals, problems, and assignments persisted in MongoDB.
# - Empty/missing → demo mode: mock personas + in-memory data, labelled
#   "Demo mode" in the UI. Automated `npm test` always uses demo mode.
VITE_API_BASE_URL=http://localhost:5000
